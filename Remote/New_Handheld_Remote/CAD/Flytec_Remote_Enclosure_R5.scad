// Flytec Remote R5 fit prototype. OpenSCAD; mm. Select part=front/rear/assembly.
part="assembly";$fn=48;W=310;H=210;D=68;wall=3;front=3.4;
screenW=108;screenH=70;screenY=2;stickX=97;stickY=73;bankX=119;bankY=-39;pitchX=19.5;pitchY=20.5;btnD=14;
module outline(){offset(r=10)polygon([[-142,-54],[-151,-34],[-151,22],[-140,54],[-121,76],[-96,91],[-70,87],[-48,71],[-29,61],[29,61],[48,71],[70,87],[96,91],[121,76],[140,54],[151,22],[151,-34],[142,-54],[128,-73],[112,-91],[89,-98],[68,-92],[49,-76],[34,-66],[-34,-66],[-49,-76],[-68,-92],[-89,-98],[-112,-91],[-128,-73]]);}
module solid(h){linear_extrude(h)outline();}
module buttons(){for(s=[-1,1],c=[-.5,.5],r=[0:3])translate([s*bankX+c*pitchX,bankY+(1.5-r)*pitchY,0])children();}
module releases(){for(c=[-.5,.5],r=[0:1])translate([bankX+c*pitchX,bankY+(1.5-r)*pitchY,0])children();}
module frontpanel(){difference(){solid(front);translate([0,screenY,-.1])linear_extrude(front+.2)offset(r=2)square([screenW-4,screenH-4],center=true);for(s=[-1,1])translate([s*stickX,stickY,-.1])cylinder(d=24.5,h=front+.2);buttons()cylinder(d=btnD,h=front+.2);translate([0,-91,-.1])cylinder(d=18,h=front+.2);translate([0,99,-.1])cylinder(d=16,h=front+.2);for(s=[-1,1])translate([s*61,94,-.1])cylinder(d=8.5,h=front+.2);for(p=[[-136,45],[136,45],[-136,-50],[136,-50],[-75,-89],[75,-89]])translate([p[0],p[1],-.1])cylinder(d=3.2,h=front+.2);}releases()difference(){cylinder(d=18.2,h=1.5);translate([0,0,-.1])cylinder(d=16.4,h=1.7);}}
module reartray(){difference(){solid(D);translate([0,0,wall])solid(D-wall+.2);for(p=[[-136,45],[136,45],[-136,-50],[136,-50],[-75,-89],[75,-89]])translate([p[0],p[1],-.1])cylinder(d=3.2,h=D+.2);for(s=[-1,1])translate([s*61,94,D-wall-.1])cylinder(d=8.5,h=wall+.2);translate([0,-105,D/2])cube([14.5,8,wall+2],center=true);for(i=[-2:2])translate([i*8,-78,D-wall-.1])cube([3,18,wall+.2],center=true);}for(p=[[-136,45],[136,45],[-136,-50],[136,-50],[-75,-89],[75,-89]])translate([p[0],p[1],wall])difference(){cylinder(d=9,h=10);translate([0,0,-.1])cylinder(d=2.8,h=10.2);}}
module cap(rel=false){union(){cylinder(d=rel?13.6:13.2,h=2.3);translate([0,0,2.3])cylinder(d=rel?10.8:10.5,h=4.7);}}
if(part=="front")frontpanel();else if(part=="rear")reartray();else{reartray();translate([0,0,D+.2])frontpanel();buttons()translate([0,0,D+front])cap();releases()translate([0,0,D+front])cap(true);translate([0,-91,D+front])cap();}
