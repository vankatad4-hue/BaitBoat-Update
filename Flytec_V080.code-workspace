{
  "folders": [
    {
      "name": "Flytec Boat — PlatformIO",
      "path": "Boat"
    },
    {
      "name": "Flytec Remote — PlatformIO",
      "path": "Remote"
    },
    {
      "name": "Shared docs",
      "path": "docs"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.pio": true
    },
    "search.exclude": {
      "**/.pio": true
    },
    "files.associations": {"*.ino": "cpp"},
    "C_Cpp.default.configurationProvider": "platformio.platformio-ide"
  },
  "extensions": {
    "recommendations": [
      "platformio.platformio-ide",
      "ms-vscode.cpptools",
      "ms-python.python"
    ]
  }
}
